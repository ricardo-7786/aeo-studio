# ============================================================
# AEO Blog Pipeline — 환경변수 예시
# 이 파일을 복사해 `.env`로 저장한 뒤 값을 채우세요.
#   cp env.example .env
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# AEO 전용 모델 (미설정 시 OPENAI_MODEL 사용)
OPENAI_AEO_MODEL=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ko
# 25MB 초과 음성 자동 압축 (STT 전) — macOS: brew install ffmpeg

# --- 실행 옵션 ---
DRY_RUN=false
OUTPUT_DIR=./output

# --- 웹 UI (2단계) ---
WEB_HOST=127.0.0.1
WEB_PORT=8787

# --- PostgreSQL (멀티 업체 DB — 범용 앱) ---
# Supabase/로컬 Postgres 연결 문자열
# DATABASE_URL=postgresql://user:pass@localhost:5432/aeo_app
# DIRECT_URL=postgresql://user:pass@localhost:5432/aeo_app
DATABASE_URL=
DEFAULT_BUSINESS_KEY=

# --- 업체 프로필 (.env 폴백 — DB 없을 때 또는 seed-from-env용) ---
# DB 사용 시 businesses 테이블이 우선 (--business-key 로 선택)
BUSINESS_KEY=OOO실용음악학원
BUSINESS_INDUSTRY=education
BUSINESS_NAME=OOO실용음악학원
BUSINESS_LOCATION=서울 마포구 홍대입구역 3번 출구
BUSINESS_ADDRESS=서울특별시 마포구 양화로 00
BUSINESS_PHONE=02-0000-0000
BUSINESS_URL=https://www.example.com
BUSINESS_SERVICES=보컬, 기타, 작곡
BUSINESS_EVIDENCE=근거/수치 문구
BUSINESS_GEO_LAT=37.5571
BUSINESS_GEO_LNG=126.9245
BUSINESS_PRICE_RANGE=$$
BUSINESS_OPENING_HOURS=Mo-Sa 10:00-22:00
# 인접 상권 — 제목 키워드 순환 (본점 지역은 location에서 자동 추출)
BUSINESS_ADJACENT_AREAS=행신, 원당, 삼송

# 레거시 alias (BUSINESS_* 와 동일 — 하위 호환)
ACADEMY_NAME=OOO실용음악학원
ACADEMY_LOCATION=서울 마포구 홍대입구역 3번 출구
ACADEMY_ADDRESS=서울특별시 마포구 양화로 00
ACADEMY_PHONE=02-0000-0000
ACADEMY_URL=https://www.example-academy.com
ACADEMY_SERVICES=보컬, 기타, 작곡, 미디, 랩
ACADEMY_EVIDENCE=2,000건 이상의 보컬 톤 교정 임상 데이터 기반
ACADEMY_GEO_LAT=37.5571
ACADEMY_GEO_LNG=126.9245
ACADEMY_PRICE_RANGE=$$
ACADEMY_OPENING_HOURS=Mo-Sa 10:00-22:00

# --- 발행 플랫폼: wordpress | tistory ---
PUBLISH_PLATFORM=wordpress

# --- WordPress REST API (Application Password 권장) ---
WP_SITE_URL=https://your-wordpress-site.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx
WP_STATUS=publish
WP_CATEGORIES=
WP_TAGS=

# --- 티스토리 Open API ---
# 앱 등록: https://www.tistory.com/guide/api/manage/register
TISTORY_ACCESS_TOKEN=your-tistory-access-token
TISTORY_BLOG_NAME=your-blog-name
TISTORY_VISIBILITY=3
# visibility: 0=비공개, 1=보호(비밀번호), 3=발행

# --- SerpAPI / AEO 템플릿 캐시 ---
# https://serpapi.com/ — 없으면 참고 URL만 수동 입력
SERPAPI_KEY=
TEMPLATE_CACHE_HOURS=72

# 네이버 본문 추출 폴백 (content_extractor.py)
JINA_READER_ENABLED=true
# JINA_API_KEY=   # 선택 — 한도 상향용

# --- CODA 연동 (web/api_v1.py) ---
# CODA 레슨 녹음 → AEO API
AEO_API_KEY=
CODA_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173

# CODA Postgres (Supabase) — AEO DATABASE_URL과 별도
# CODA 프로젝트 .env.local 의 DATABASE_URL / DIRECT_URL 값을 복사
# CODA_DATABASE_URL=postgresql://postgres:...@db....supabase.co:5432/postgres
CODA_DATABASE_URL=
# CODA_DIRECT_URL=
# /generate 레슨 목록 필터 (기본: 전창영)
CODA_TEACHER_NAME=전창영

# --- 실행 옵션 ---
DRY_RUN=false
OUTPUT_DIR=./output
